# Forgejo MCP Server - environment variables
# Copy to .env and fill in what you need:  cp .env.sample .env
# Generate secrets with:                    openssl rand -hex 32

# =============================================================================
# Local CLI / stdio mode (npx mcp-forgejo) and the live smoke test
# =============================================================================
# Base URL of your Forgejo instance (Codeberg: https://codeberg.org).
# In HTTP mode these are only used as a fallback for self-hosted requests.
FORGEJO_URL=
# Personal access token: Forgejo → Settings → Applications → Generate New Token.
# Grant read/write for repository, issue, notification and user
# (plus organization/package/admin only if you need those toolsets).
FORGEJO_ACCESS_TOKEN=

# Which tools to expose (comma-separated): default, all, or any of
#   users, repos, code, issues, pulls, notifications, actions, actions_admin,
#   releases, wiki, labels, orgs, repo_admin, packages, admin
# FORGEJO_TOOLSETS=default
# Hide every tool that writes to Forgejo:
# FORGEJO_READ_ONLY=false

# =============================================================================
# Hosted mode (mcp-key-service) - used on the VPS
# =============================================================================
# Users connect with https://mcp.techmavie.digital/forgejo/mcp/usr_...
# Both must be set together (or both left empty).
# Inside Docker on the shared mcp-network:
#   KEY_SERVICE_URL=http://mcp-key-service:8090/internal/resolve
# From outside Docker:
#   KEY_SERVICE_URL=https://mcpkeys.techmavie.digital/internal/resolve
KEY_SERVICE_URL=
# Must match the "forgejo:<token>" entry in mcp-key-service's INTERNAL_SERVER_TOKENS.
KEY_SERVICE_TOKEN=
# KEY_SERVICE_SERVER_ID=forgejo
# Where users manage their keys (shown in error messages).
# KEY_PORTAL_URL=https://mcpkeys.techmavie.digital

# Host port docker-compose publishes on 127.0.0.1 (nginx proxies /forgejo/ to it).
# Must be free on the VPS (ss -tlnp) and match proxy_pass in deploy/nginx-mcp.conf.
MCP_HOST_PORT=8099

# =============================================================================
# Self-hosted mode + analytics
# =============================================================================
# Shared secret for X-API-Key. Enables:
#   - POST /mcp with X-API-Key + X-Forgejo-Url + X-Forgejo-Token headers
#   - /analytics and the dashboard data
# Leave empty to disable both.
MCP_API_KEY=

# =============================================================================
# Outbound network policy (SSRF guard for user-supplied instance URLs)
# =============================================================================
# The HTTP server refuses http:// instances and private/internal addresses by
# default. Only relax this on a private, single-user deployment.
# FORGEJO_ALLOW_HTTP=false
# FORGEJO_ALLOW_PRIVATE_HOSTS=false
# Host names exempt from the private-address check (e.g. your own instance
# reached through Docker's host-gateway):
# FORGEJO_TRUSTED_HOSTS=

# =============================================================================
# Optional
# =============================================================================
# PORT=8080
# HOST=0.0.0.0
# PUBLIC_BASE_PATH=/forgejo             # prefix nginx adds (used in advertised URLs)
# ANALYTICS_DIR=/app/data
# ALLOWED_ORIGINS=*                     # comma-separated list for browser clients
# FORGEJO_TIMEOUT_MS=30000              # per request to Forgejo
# FORGEJO_MAX_RESPONSE_MB=20            # largest Forgejo response the server will read
# MCP_PROTOCOL_VERSION=2025-11-25
# MCP_BODY_LIMIT=10mb
# MCP_TRACE_HTTP=false                  # log one line per MCP request (no secrets)
# ENABLE_MCP_DIAGNOSTICS=false          # enables /mcp-debug/open (no-auth ping tool)

# Live smoke test (npm run smoke): set to 1 to also create and delete a
# throw-away repository on FORGEJO_URL.
# SMOKE_WRITE=0
